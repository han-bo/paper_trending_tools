GITHUB_TOKEN=
# GitHub 搜索（建议偏趋势发现）：可用 stars 区间/关键词自定义
GITHUB_SEARCH_QUERY=stars:>50
GITHUB_PUSHED_DAYS=7
# 仅抓取最近 N 天创建的仓库（避免常年顶流占榜）
GITHUB_CREATED_DAYS=30
# 过滤 stars 过高的超头部（避免 vscode/linux 等常年顶流；想放开就调大）
GITHUB_MAX_STARS=300000
GITHUB_PER_PAGE=20

ARXIV_RSS_URLS=http://export.arxiv.org/rss/cs.AI
ARXIV_MAX_ENTRIES=30
# 建议改为含联系方式，例如：MyTool/1.0 (mailto:you@example.com)，见 arXiv API 手册
# ARXIV_HTTP_USER_AGENT=

DATABASE_URL=sqlite:///data/local.db

VOLCENGINE_API_KEY=
VOLCENGINE_API_BASE=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_MODEL=
# 方舟 HTTP 超时（秒）：大 README / 慢模型可调大 VOLCENGINE_READ_TIMEOUT
VOLCENGINE_CONNECT_TIMEOUT=30
VOLCENGINE_READ_TIMEOUT=300
# 429 限频：最大尝试次数（含首次）、退避基数秒；两次 LLM 成功调用之间休眠秒数（0=不休眠）
VOLCENGINE_429_MAX_ATTEMPTS=8
VOLCENGINE_429_BASE_WAIT_SECONDS=2
VOLCENGINE_LLM_INTERVAL_SECONDS=1.5
LLM_GITHUB_README_MAX_CHARS=6000
LLM_PAPER_ABSTRACT_MAX_CHARS=8000

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 邮件摘要（可选，与 Telegram 可同时启用；通过 Zoho Mail API 发信）
DIGEST_EMAIL_TO=
DIGEST_EMAIL_SUBJECT=【今日值得关注】研究摘要

# Zoho Mail API（OAuth + HTTPS；scope 需含 ZohoMail.messages.CREATE 等，见官方文档）
# 数据中心须一致：国际 accounts.zoho.com + mail.zoho.com；欧洲 .eu；印度 .in
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.com
ZOHO_MAIL_API_BASE=https://mail.zoho.com
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_CLIENT_SECRET=
ZOHO_OAUTH_REFRESH_TOKEN=
# 发件地址，须为该邮箱账户下已验证别名/主邮箱
ZOHO_MAIL_FROM=
# 若留空，代码里可 GET /api/accounts 取 data[0].accountId；若多邮箱账户可在此填固定 accountId
# ZOHO_MAIL_ACCOUNT_ID=

DIGEST_GITHUB_TOP_N=5
DIGEST_ARXIV_TOP_N=3
LLM_ANALYZE_GITHUB_TOP=15
LLM_ANALYZE_ARXIV_TOP=10

SCHEDULER_CRON_HOUR=8
SCHEDULER_CRON_MINUTE=0
SCHEDULER_TIMEZONE=Asia/Shanghai
